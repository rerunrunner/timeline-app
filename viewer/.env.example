# PostHog fallback for local validation only. The preferred production path is
# site-provided runtime-config.js, so local env files are usually unnecessary.
# Omit both to run the viewer without analytics.
# Create a project at https://posthog.com — use the API host for your region (US/EU),
# or your reverse-proxy / custom domain (e.g. https://t.example.com).
# These values are only used as a fallback during `npm run dev`.
# `npm run build` and `npm run preview` use runtime-config.js instead.
# During `npm run dev`, PostHog stays off even if token/host are set; set the line below
# to true to test analytics locally.
VITE_PUBLIC_POSTHOG_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# VITE_PUBLIC_POSTHOG_ENABLE_IN_DEV=true
